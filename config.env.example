# Скопируй этот файл в config.env и заполни своими значениями
# cp config.env.example config.env

# Подключение к PostgreSQL BrAIniac
# (хост и порт для запуска вне Docker — при запуске через docker compose
#  они переопределяются в docker-compose.yml на db:5432)
user=brainiac
password=YOUR_DB_PASSWORD
database=brainiac
host=127.0.0.1
port=5433
